# Database Configuration
DATABASE_URL="postgresql://user:password@host:5432/said_api"

# Solana Network
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# Security - Admin Authentication
# Generate with: openssl rand -hex 32
ADMIN_SECRET=""

# Trusted Source API Keys (Optional - for partner platforms)
# These platforms can submit feedback without wallet signatures
# (legacy POST /api/sources/feedback and batch POST /api/outcomes/batch)
TORCH_API_KEY=""
SOLPRISM_API_KEY=""
AGENTDEX_API_KEY=""
# Additional partners, comma-separated "name:key:weight" entries
# e.g. "acme:supersecret:1.5,other:key2:1.2" — weight in (0, 3]
PARTNER_SOURCE_KEYS=""

# Email Notifications (Optional)
RESEND_API_KEY=""

# Sponsorship Configuration (Optional)
# Private key for sponsoring agent registrations
SPONSOR_PRIVATE_KEY=""

# Server Configuration
PORT=3000
NODE_ENV="production"
